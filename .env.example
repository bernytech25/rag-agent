# Never commit a populated .env file.
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=60

# JSON mapping of username to a bcrypt hash and role. Do not store plaintext passwords.
# Generate a hash with:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('choose-a-password'))"
RAG_USERS_JSON={"admin":{"hashed_password":"replace-with-a-bcrypt-hash","role":"admin"}}
